# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specific to package
coverage.out

# Go workspace file
go.work

# Dependency directories (remove the comment below to ignore vendored dependencies)
/vendor/

# Go build output
/bin/
/build/
/dist/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Local environment files
.env
.env.*

# Logs
*.log
